{
  "expo": {
    "name": "Mahjong Tarot",
    "slug": "mahjong-tarot",
    "scheme": "mahjongtarot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "web"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.talentedge.mahjongtarot",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:www.mahjongtarot.com",
        "webcredentials:www.mahjongtarot.com"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
